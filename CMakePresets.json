{
    "version": 10,
    "configurePresets": [
        {
            "$comment": [
                "Default configuration preset, using Ninja generator",
                "and Vcpkg toolchain file for dependency management."
            ],
            "name": "default",
            "displayName": "Default Configuration",
            "description": "Default configuration for CMake project using Ninja generator.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/default",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 3
    },
    "buildPresets": [
        {
            "name": "default",
            "displayName": "Default build"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {"outputOnFailure": true},
            "execution": {"noTestsAction": "error", "stopOnFailure": true}
        }
    ],
    "packagePresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "generators": [
                "TGZ"
            ]
        }
    ]
}